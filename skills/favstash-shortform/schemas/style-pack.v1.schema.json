{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.favstash.app/schemas/shortform/style-pack.v1.schema.json",
  "title": "FavStash editing style pack",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "format", "bestFor", "avoidWhen", "creativePrinciples", "requiredReview"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "format": { "enum": ["video", "carousel"] },
    "bestFor": { "type": "array", "items": { "type": "string" } },
    "avoidWhen": { "type": "array", "items": { "type": "string" } },
    "creativePrinciples": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "defaultRanges": { "type": "object" },
    "requiredReview": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "examples": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
